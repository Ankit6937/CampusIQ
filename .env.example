# ---- Backend (copy this file to backend/.env) ----
# Option A: local MongoDB (docker compose up -d)
MONGODB_URI=mongodb://127.0.0.1:27017/campusiq
# Option B: MongoDB Atlas (replace the line above)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusiq?retryWrites=true&w=majority
PORT=5000
PYTHON_API_URL=http://localhost:8000
CLIENT_ORIGIN=http://localhost:5173
# Optional: Gemini API key. App works without it (falls back to predefined analytics answers)
AI_API_KEY=
# AI_MODEL=gemini-2.0-flash

# ---- Frontend (put in frontend/.env) ----
VITE_API_URL=http://localhost:5000/api
